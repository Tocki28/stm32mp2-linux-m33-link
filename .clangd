# Editor (clangd) settings: tell the editor what the Makefile tells the compiler.
# Each -I path is relative to the edited file's own folder.
CompileFlags:
  Add: [-std=c++17]
---
# Flight code: sees config/, fsw/inc/ and fsw/src/, like the flight build.
If:
  PathMatch: fsw/(inc|src)/.*
CompileFlags:
  Add: [-I../../config, -I../inc, -I../src]
---
# Test code: also sees ut-stubs/ and ut-coverage/, and defines LINK_TEST_BUILD
# (guard 1). Without this the editor would show the guard's #error in them.
If:
  PathMatch: ut-(coverage|stubs)/.*
CompileFlags:
  Add: [-DLINK_TEST_BUILD, -I../config, -I../fsw/inc, -I../fsw/src, -I../ut-stubs, -I../ut-coverage]
